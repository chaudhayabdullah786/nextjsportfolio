# ============================================================
# ENVIRONMENT CONFIGURATION — PLACEHOLDERS ONLY
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# -----------------------------------------------------------
# DATABASE
# -----------------------------------------------------------
# PostgreSQL connection string for Prisma ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# -----------------------------------------------------------
# AUTHENTICATION
# Used by NextAuth / Auth.js for session encryption.
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------
AUTH_SECRET=

# -----------------------------------------------------------
# GEMINI AI ASSISTANT
# -----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Whether the AI assistant is active (true / false)
AI_ASSISTANT_ENABLED=false

# Provider (currently only "gemini" is supported)
AI_PROVIDER=gemini

# Timeout for AI responses in seconds (3–15, default 8)
AI_TIMEOUT_SECONDS=8

# Max characters in a single visitor message (100–2000, default 1000)
AI_MAX_INPUT_CHARS=1000

# Max output tokens from the AI (64–500, default 250)
AI_MAX_OUTPUT_TOKENS=250

# Max conversation history messages to include (0–10, default 6)
AI_MAX_HISTORY_MESSAGES=6

# Max total characters of conversation history (0–6000, default 3000)
AI_MAX_HISTORY_CHARS=3000

# Max total characters of portfolio context injected (2000–20000, default 12000)
AI_MAX_CONTEXT_CHARS=12000

# Max items retrieved for context injection (1–15, default 8)
AI_MAX_RETRIEVED_ITEMS=8

# Max total assembled prompt characters (5000–30000, default 18000)
AI_MAX_PROMPT_CHARS=18000

# Rate limits
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=50

# Max request body size in bytes (4096–32768, default 16384)
AI_MAX_REQUEST_BYTES=16384

# -----------------------------------------------------------
# SITE
# -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# -----------------------------------------------------------
# EMAIL (Contact form)
# -----------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
CONTACT_RECIPIENT_EMAIL=
